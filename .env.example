# ---- 基础 ----
# 时区（影响自动备份时间与“今天”的判定）
TZ=Asia/Shanghai
# 宿主机映射端口
HOST_PORT=8787
# 数据目录文件属主（群晖 / Unraid 常见为 1026:100 或 99:100，可用 `id` 命令查看）
PUID=1000
PGID=1000

# ---- 首次启动创建管理员（已有账号时忽略；创建后可删除这两行）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成至少8位的强密码

# ---- 反向代理 / 公网访问 ----
# 对外访问地址，用于跨站校验与 Cookie Secure 判断
# BASE_URL=https://invest.example.com
# 位于 Nginx / Caddy / Traefik 等反向代理之后时开启
# TRUST_PROXY=1

# ---- 备份 ----
# 自动备份时间（cron 表达式），设为 off 关闭
BACKUP_CRON=0 3 * * *
# 自动备份保留份数
BACKUP_KEEP=14

# ---- 其他 ----
# 首次启动时默认资产类别的语言：zh-CN / en（界面语言在网页中切换）
DEFAULT_LOCALE=zh-CN
# 登录有效天数（活跃使用时自动续期）
SESSION_DAYS=7
# 日志级别：fatal / error / warn / info / debug
LOG_LEVEL=info
