{
  "name": "@invest-insight/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ii": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.3",
    "better-sqlite3": "^12.2.0",
    "croner": "^9.0.0",
    "decimal.js": "^10.5.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@invest-insight/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
